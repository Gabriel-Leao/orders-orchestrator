# ---------- App ----------
PORT=3333
NODE_ENV=development
# Chave exigida no header x-api-key (troque em qualquer ambiente real)
API_KEY=change-me

# ---------- PostgreSQL ----------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=orders

# ---------- Redis (BullMQ) ----------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- Enriquecimento (API de câmbio - Frankfurter, sem chave) ----------
EXCHANGE_API_URL=https://api.frankfurter.dev/v1
TARGET_CURRENCY=BRL
EXTERNAL_TIMEOUT_MS=5000

# ---------- Retry / backoff ----------
ENRICHMENT_MAX_ATTEMPTS=5
ENRICHMENT_BACKOFF_MS=1000
